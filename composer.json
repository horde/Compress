{
    "name": "horde/compress",
    "description": "Compression library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Compress",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "developer"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "gzip",
        "zip",
        "tnef"
    ],
    "time": "2026-06-27",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/mime": "^3 || dev-FRAMEWORK_6_0",
        "horde/translation": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/icalendar": "^3 || dev-FRAMEWORK_6_0",
        "horde/mail": "^3 || dev-FRAMEWORK_6_0",
        "horde/mapi": "^2 || dev-FRAMEWORK_6_0",
        "horde/stream_filter": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/icalendar": "^3 || dev-FRAMEWORK_6_0",
        "horde/mail": "^3 || dev-FRAMEWORK_6_0",
        "horde/mapi": "^2 || dev-FRAMEWORK_6_0",
        "horde/stream_filter": "^3 || dev-FRAMEWORK_6_0",
        "ext-zlib": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Compress": "lib/"
        },
        "psr-4": {
            "Horde\\Compress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Compress\\Test\\": "test/",
            "Horde\\Compress\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}